                <strong>{{ site.name }}</strong><br>
                {{ site.address.full }}<br>
                Phone: <a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a>
            </p>
            
            <p>For a copy of our full HIPAA Notice of Privacy Practices, please request one at our office or call us.</p>
