<!-- Visit Our Lehi Office -->
<section class="location" id="location">
    <div class="container">
        <div class="location-image">
            <img src="/images/lehi-dermatology-clinic.jpg" alt="Smart Skin Dermatology office building in Lehi Utah near Thanksgiving Point">
        </div>
        <div class="location-content">
            <h2>Visit Our Lehi Office</h2>
            <p>Conveniently located near Thanksgiving Point, we serve patients throughout Utah County including American Fork, Saratoga Springs, Eagle Mountain, Pleasant Grove, and Draper.</p>
            <div class="contact-info">
                <div class="contact-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    <div>
                        <strong>Address</strong>
                        <span>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span>
                    </div>
                </div>
                <div class="contact-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                    <div>
                        <strong>Phone</strong>
                        <a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a>
                    </div>
                </div>
                <div class="contact-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                    <div>
                        <strong>Office Hours</strong>
                        <span>Mon, Tue, Thu: {{ site.hours.monday }}<br>
                        Wednesday: {{ site.hours.wednesday }}<br>
                        Friday: {{ site.hours.friday }}</span>
                    </div>
                </div>
            </div>
            <a href="tel:{{ site.phoneRaw }}" class="btn btn-primary" style="margin-top: 30px;">Request Appointment</a>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="team" id="team">
    <div class="container">
        <div class="team-images">
            <img src="/images/dr-smart-1.png" alt="Dr. David Smart - Board Certified Dermatologist at Smart Skin Dermatology Lehi Utah" class="main-headshot">
            <img src="/images/LindsaySalazar-17.jpg" alt="Smart Skin Dermatology team member providing patient care">
            <img src="/images/LindsaySalazar-21.jpg" alt="Friendly dermatology staff at Smart Skin Dermatology clinic">
        </div>
        <div class="team-content">
            <h2>Meet Your <span>Dermatology Team</span></h2>
            <p>Smart Skin Dermatology brings together board-certified dermatologists and experienced providers with over 30 years of combined experience. We're dedicated to providing personalized, compassionate care for every patient.</p>
            <p>Our team specializes in everything from complex skin cancer cases to cosmetic enhancements, ensuring you receive expert care under one roof.</p>
            <div class="team-members">
                {% for member in site.team %}
                <span class="team-member-badge">{{ member.name }}, {{ member.credentials }}</span>
                {% endfor %}
            </div>
            <a href="/about/" class="btn btn-primary">Meet the Full Team</a>
        </div>
    </div>
</section>
