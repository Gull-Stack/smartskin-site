<!-- Services Section -->
<section class="services" id="services">
    <div class="container">
        <div class="section-header">
            <h2>Our Dermatology Services</h2>
            <p>Comprehensive skin care solutions from medical treatments to cosmetic enhancements, all under one roof.</p>
        </div>
        <div class="services-grid">
            <div class="service-card">
                <img src="/images/Asset-1.png" alt="Medical dermatology consultation at Smart Skin Dermatology in Lehi Utah">
                <div class="service-card-content">
                    <h3>Medical Dermatology</h3>
                    <p>Expert diagnosis and treatment for acne, eczema, psoriasis, rosacea, and all skin conditions affecting your health and comfort.</p>
                    <a href="/services/medical-dermatology/">Learn More →</a>
                </div>
            </div>
            <div class="service-card">
                <img src="/images/surgical-derm-1.png" alt="Surgical dermatology and skin cancer removal at Smart Skin Dermatology">
                <div class="service-card-content">
                    <h3>Surgical Dermatology</h3>
                    <p>Expert surgical removal of skin cancers, cysts, moles, and other growths with precision techniques and minimal scarring.</p>
                    <a href="/services/surgical-dermatology/">Learn More →</a>
                </div>
            </div>
            <div class="service-card">
                <img src="/images/Asset-2.png" alt="Cosmetic dermatology treatments including Botox at Smart Skin Dermatology Lehi">
                <div class="service-card-content">
                    <h3>Cosmetic Dermatology</h3>
                    <p>Rejuvenate your appearance with Botox, chemical peels, microneedling, and advanced skincare for radiant, youthful skin.</p>
                    <a href="/services/cosmetic-dermatology/">Learn More →</a>
                </div>
            </div>
        </div>
    </div>
</section>

