---
layout: base.njk
title: Lehi's Top Dermatologist
description: Looking for a trusted dermatologist in Lehi, UT? Smart Skin Dermatology offers expert skin cancer screening, acne treatment & cosmetic dermatology. Book your appointment today!
---

{% block schema %}
<!-- LocalBusiness Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "@id": "{{ site.url }}/#organization",
    "name": "{{ site.name }}",
    "image": "{{ site.url }}/images/smart-skin-dermatology.jpg",
    "logo": "{{ site.url }}/images/smart-skin-07.png",
    "url": "{{ site.url }}/",
    "telephone": "+1-385-273-3376",
    "priceRange": "$$",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.address.street }}",
        "addressLocality": "{{ site.address.city }}",
        "addressRegion": "{{ site.address.state }}",
        "postalCode": "{{ site.address.zip }}",
        "addressCountry": "US"
    },
    "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ site.geo.lat }},
        "longitude": {{ site.geo.lng }}
    },
    "openingHoursSpecification": [
        {"@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "08:30", "closes": "17:00"},
        {"@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "08:30", "closes": "17:00"},
        {"@type": "OpeningHoursSpecification", "dayOfWeek": "Wednesday", "opens": "07:00", "closes": "17:00"},
        {"@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "08:30", "closes": "17:00"},
        {"@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "08:30", "closes": "13:00"}
    ],
    "medicalSpecialty": "Dermatology",
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "312",
        "bestRating": "5"
    }
}
</script>

<!-- Physician Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Physician",
    "name": "{{ site.doctor.name }}",
    "image": "{{ site.url }}/images/dr-smart-1.png",
    "description": "Board-certified dermatologist with over 30 years of experience specializing in medical, surgical, and cosmetic dermatology in Lehi, Utah.",
    "medicalSpecialty": "Dermatology",
    "memberOf": {
        "@type": "MedicalOrganization",
        "name": "American Academy of Dermatology"
    },
    "worksFor": {
        "@type": "MedicalBusiness",
        "name": "{{ site.name }}",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "{{ site.address.street }}",
            "addressLocality": "{{ site.address.city }}",
            "addressRegion": "{{ site.address.state }}",
            "postalCode": "{{ site.address.zip }}"
        }
    }
}
</script>
{% endblock %}

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Lehi's Most Trusted <span>Dermatology</span> Practice</h1>
            <p>Expert skin care for the whole family. From comprehensive skin cancer screenings to advanced cosmetic treatments, our board-certified team delivers personalized care you can trust.</p>
            <div class="hero-cta">
                <a href="tel:{{ site.phoneRaw }}" class="btn btn-primary">Schedule Consultation</a>
                <a href="/services/" class="btn btn-outline">View Our Services</a>
            </div>
        </div>
        <div class="hero-image">
            <img src="/images/lehi-dermatology-clinic.jpg" alt="Smart Skin Dermatology clinic exterior in Lehi, Utah - Board certified dermatologists serving Utah County">
            <div class="hero-badge">
                <div class="number">30+</div>
                <div class="label">Years Experience</div>
            </div>
        </div>
    </div>
</section>

